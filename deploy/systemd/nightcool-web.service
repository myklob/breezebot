[Unit]
Description=NightCool web — PWA host + HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nightcool
WorkingDirectory=/opt/nightcool
ExecStart=/opt/nightcool/.venv/bin/nightcool serve --config /opt/nightcool/config.yaml --state /opt/nightcool/state.json
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
